cabal-version:      3.14
name:               wasmdemo
version:            0.1.0.0
-- synopsis:
-- description:
license:            MIT
license-file:       LICENSE
author:             Frank Staals
maintainer:         frank@fstaals.net
-- copyright:
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall -lwasi-emulated-getpid

    build-depends:
        base             >=4.20.0.0  && < 5
      , hexpat           >= 0.20.13  && < 0.21
      , bytestring       >= 0.12     && < 0.13
      , text             >= 2.1      && < 2.2
      , ghc-experimental
         -- >= 9.1201   && < 9.14

    default-language: GHC2024

executable wasmdemo
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    hs-source-dirs:   app


executable wasmdemo-web
    import:           warnings
    main-is:          Web.hs
    ghc-options: -no-hs-main -optl-mexec-model=reactor -optl-Wl,--export=hs_start

    -- other-modules:
    -- other-extensions:

    hs-source-dirs:   app
